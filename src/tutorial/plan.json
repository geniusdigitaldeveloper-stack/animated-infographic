 "subs": [
  {
   "out0": 0.2,
   "out1": 12.45,
   "text": "Untuk membuat pembayaran, secara automatik kita akan dibawa ke satu platform seperti ini: [[Global Streamer]]."
  },
  {
   "out0": 13.2,
   "out1": 19.85,
   "text": "Kalau tidak, pergi balik pada e-mel yang kita masukkan waktu beli."
  },
  {
   "out0": 20.65,
   "out1": 23.4,
   "text": "Dekat e-mel, kita akan dapat [[3 e-mel]] seperti ini."
  },
  {
   "out0": 24.25,
   "out1": 30.3,
   "text": "Jadi, kamu boleh pilih antara nak tekan yang muat turun atau akses,"
  },
  {
   "out0": 30.8,
   "out1": 36.35,
   "text": "atau pun kamu nak tekan pada yang jenis digital ini. Terima kasih, pembayaran berjaya."
  },
  {
   "out0": 36.6,
   "out1": 39.05,
   "text": "Kalau klik sini, akan nampak seperti ini."
  },
  {
   "out0": 39.8,
   "out1": 42.15,
   "text": "Nampak, dia akan beritahu nama kita sekali."
  },
  {
   "out0": 42.3,
   "out1": 44.65,
   "text": "So klik pada [[Buka Panduan dan Muat Turun]]."
  },
  {
   "out0": 45.55,
   "out1": 48.0,
   "text": "Sama saja platform dia, dia akan keluar seperti ini."
  },
  {
   "out0": 49.65,
   "out1": 55.5,
   "text": "Bila dah keluar seperti ini, kita tengok dulu video tutorial."
  },
  {
   "out0": 55.75,
   "out1": 59.7,
   "text": "Sebab tutorial ini, sama saja segala penerangan dalam ini."
  },
  {
   "out0": 59.65,
   "out1": 61.9,
   "text": "Cuma kita nak direct terus kepada salin."
  },
  {
   "out0": 62.25,
   "out1": 65.1,
   "text": "{{Salin}} di sini, ataupun muat turun terus."
  },
  {
   "out0": 65.55,
   "out1": 67.1,
   "text": "Kalau aku, suka salin."
  },
  {
   "out0": 66.95,
   "out1": 71.2,
   "text": "Selepas tekan salin, kita buka Chrome yang baru, kita paste link di sini."
  },
  {
   "out0": 71.8,
   "out1": 72.85,
   "text": "Kemudian Enter."
  },
  {
   "out0": 73.3,
   "out1": 77.75,
   "text": "Bila Enter, dia akan automatik terus download aplikasi kita."
  },
  {
   "out0": 78.0,
   "out1": 78.75,
   "text": "Nampak di sini."
  },
  {
   "out0": 79.2,
   "out1": 83.75,
   "text": "Okey, lepas dah siap download, kita terus ke setup di sini."
  },
  {
   "out0": 83.9,
   "out1": 84.95,
   "text": "Tekan anak panah ini."
  },
  {
   "out0": 85.2,
   "out1": 88.75,
   "text": "Ataupun kalau kita nak tengok file kita di mana, kita tekan di sini."
  },
  {
   "out0": 88.9,
   "out1": 89.85,
   "text": "[[Show in folder]]."
  },
  {
   "out0": 90.2,
   "out1": 91.95,
   "text": "Kalau nak setup terus, tekan dia."
  },
  {
   "out0": 92.2,
   "out1": 93.05,
   "text": "Anak panah ini, [[Open]]."
  },
  {
   "out0": 93.6,
   "out1": 96.25,
   "text": "Kita tunggu kejap, dia akan keluar macam ini."
  },
  {
   "out0": 97.4,
   "out1": 98.55,
   "text": "Kita tekan {{More info}}."
  },
  {
   "out0": 99.0,
   "out1": 100.15,
   "text": "Kita [[Run anyway]]."
  },
  {
   "out0": 100.2,
   "out1": 101.15,
   "text": "Sebab apa keluar macam ini?"
  },
  {
   "out0": 101.1,
   "out1": 103.35,
   "text": "Sebab aplikasi ini adalah aplikasi yang baru."
  },
  {
   "out0": 103.6,
   "out1": 105.55,
   "text": "Kemudian kita tekan dia, [[Run anyway]]."
  },
  {
   "out0": 105.7,
   "out1": 108.55,
   "text": "{{Jangan risau}}, benda ini bukan ada virus ke apa."
  },
  {
   "out0": 108.8,
   "out1": 109.85,
   "text": "Scam ke, bukan."
  },
  {
   "out0": 110.2,
   "out1": 112.35,
   "text": "Tapi sebab benda ini ada benda yang baru."
  },
  {
   "out0": 112.6,
   "out1": 117.85,
   "text": "Lepas kita Run anyway, dia akan bagi pilihan untuk kita pilih desktop kita."
  },
  {
   "out0": 118.25,
   "out1": 121.6,
   "text": "Okey, kita pilih PC atau laptop lah."
  },
  {
   "out0": 121.45,
   "out1": 122.3,
   "text": "Tekan [[Next]]."
  },
  {
   "out0": 122.35,
   "out1": 125.3,
   "text": "Kemudian pilih lokasi yang kita nak simpan aplikasi."
  },
  {
   "out0": 125.45,
   "out1": 126.6,
   "text": "Tekan [[Install]]."
  },
  {
   "out0": 126.85,
   "out1": 128.9,
   "text": "Lepas dah install, kita tekan [[Finish]]."
  },
  {
   "out0": 129.15,
   "out1": 133.5,
   "text": "Kemudian kita terus dapat aplikasi untuk kita buat live streaming."
  },
  {
   "out0": 134.55,
   "out1": 135.0,
   "text": "Nampak?"
  },
  {
   "out0": 135.5,
   "out1": 136.95,
   "text": "Dia automatik bagi macam itu."
  },
  {
   "out0": 137.4,
   "out1": 141.15,
   "text": "Okey, sekarang ini [[versi 2.131]]."
  },
  {
   "out0": 141.4,
   "out1": 144.05,
   "text": "So dalam ini kita boleh set kita punya live streaming."
  },
  {
   "out0": 144.1,
   "out1": 145.95,
   "text": "Nak masukkan laptop punya live."
  },
  {
   "out0": 146.2,
   "out1": 147.15,
   "text": "Ini [[Stream Key]]."
  },
  {
   "out0": 147.6,
   "out1": 149.35,
   "text": "Facebook pun ada Stream Key."
  },
  {
   "out0": 149.2,
   "out1": 152.15,
   "text": "Dan boleh tambah lagi kalau nak mana-mana."
  },
  {
   "out0": 152.55,
   "out1": 154.8,
   "text": "Okey, untuk aplikasi ini,"
  },
  {
   "out0": 155.15,
   "out1": 158.3,
   "text": "fokus utama dia kepada [[Mobile Legends]], memang lah."
  },
  {
   "out0": 158.45,
   "out1": 165.3,
   "text": "Kemudian dalam ini juga untuk mana-mana pelajar, cikgu, atau pensyarah yang nak buat presentation."
  },
  {
   "out0": 165.55,
   "out1": 167.8,
   "text": "Nak letak muka, nak letak slide pun boleh."
  },
  {
   "out0": 167.75,
   "out1": 170.7,
   "text": "Di sini pun kita akan ada [[Mode Formal]]."
  },
  {
   "out0": 171.15,
   "out1": 174.5,
   "text": "Itu mode untuk kita pilih slide kita."
  },
  {
   "out0": 174.35,
   "out1": 178.4,
   "text": "So kat sini akan ada kamera, apa semua, kita boleh masukkan PDF."
  },
  {
   "out0": 178.55,
   "out1": 180.7,
   "text": "Okey, PDF macam mana? Kita klik kat sini."
  },
  {
   "out0": 181.15,
   "out1": 183.1,
   "text": "So kita cari PDF."
  },
  {
   "out0": 183.7,
   "out1": 185.15,
   "text": "Presentation PDF, PowerPoint."
  },
  {
   "out0": 185.6,
   "out1": 188.55,
   "text": "Okey, bila kita klik sini, kita cari PDF kita kat mana."
  },
  {
   "out0": 189.0,
   "out1": 190.85,
   "text": "Okey, contoh kita buka."
  },
  {
   "out0": 191.2,
   "out1": 192.35,
   "text": "Soalan dan soalan."
  },
  {
   "out0": 192.3,
   "out1": 192.65,
   "text": "Nampak?"
  },
  {
   "out0": 193.0,
   "out1": 194.95,
   "text": "So kita crop je lah macam biasa."
  },
  {
   "out0": 195.8,
   "out1": 197.85,
   "text": "Jadi muka kita kat situ."
  },
  {
   "out0": 198.45,
   "out1": 199.7,
   "text": "Kita transition je."
  },
  {
   "out0": 199.55,
   "out1": 203.7,
   "text": "So dekat paparan ini lah yang kita akan bentangkan kepada umum."
  },
  {
   "out0": 203.55,
   "out1": 205.3,
   "text": "Yang dalam live tu, paparan ni."
  },
  {
   "out0": 205.65,
   "out1": 208.9,
   "text": "Okey, ni ada untuk setup, kita nak tambah apa-apa boleh tambah kat sini."
  },
  {
   "out0": 209.05,
   "out1": 211.5,
   "text": "Okey, [[selamat mencuba]] dan semoga berjaya."
  },
  {
   "out0": 211.85,
   "out1": 212.5,
   "text": "Assalamualaikum."
  }
 ],
