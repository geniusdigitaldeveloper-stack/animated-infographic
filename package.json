{
  "name": "animated-infographic",
  "version": "1.0.0",
  "private": true,
  "description": "Motion-graphics explainer reels (talking head + animated infographic cards) built with Remotion.",
  "scripts": {
    "dev": "remotion studio",
    "build:site": "remotion bundle --out-dir=site",
    "render": "remotion render Explainer out/explainer.mp4",
    "still": "remotion still Explainer out/still.png --frame=120",
    "typecheck": "tsc --noEmit",
    "captions": "node scripts/whisper-to-captions.mjs",
    "render:reel": "remotion render Explainer out/reel-1080x1920.mp4 --props='{\"width\":1080,\"height\":1920}'",
    "render:landscape": "remotion render Explainer out/landscape-1920x1080.mp4 --props='{\"width\":1920,\"height\":1080}'",
    "render:square": "remotion render Explainer out/square-1080x1080.mp4 --props='{\"width\":1080,\"height\":1080}'",
    "render:portrait": "remotion render Explainer out/portrait-1080x1350.mp4 --props='{\"width\":1080,\"height\":1350}'"
  },
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "@remotion/google-fonts": "4.0.543",
    "@remotion/media-utils": "4.0.543",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "typescript": "^7.0.2"
  }
}
